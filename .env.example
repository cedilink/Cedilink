# Base URL of the Smartpay backend (no trailing slash, no /v1).
API_URL=http://localhost:4000

# Show Albedo as a selectable wallet in the checkout. Freighter is always available.
NEXT_PUBLIC_ALBEDO_ENABLED=false

# Public address of this app, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.cedilink.com

# Optional: ownership codes from Google Search Console and Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
